{
  "name": "url-shortener-root",
  "version": "1.0.0",
  "description": "Full-Stack URL Shortener with Analytics",
  "scripts": {
    "db:create": "mkdir db_data",
    "db:start": "powershell -Command \"& 'C:\\Program Files\\MongoDB\\Server\\8.2\\bin\\mongod.exe' --dbpath .\\db_data --port 27017\"",
    "backend:install": "cd backend && npm install",
    "backend:start": "cd backend && npm run dev",
    "frontend:install": "cd frontend && npm install",
    "frontend:start": "cd frontend && npm run dev",
    "install-all": "npm run backend:install && npm run frontend:install",
    "dev": "npx concurrently \"npm run db:start\" \"npm run backend:start\" \"npm run frontend:start\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "mongodb": "^7.2.0",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
